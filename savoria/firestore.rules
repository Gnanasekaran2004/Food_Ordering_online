rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ── Users Profile ───────────────────────────────────────────
    match /users/{uid} {
      // Users can read and write their own profile
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) 
                    && request.resource.data.role == 'customer'
                    && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
                    // Users cannot promote themselves or alter server fields
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt', 'emailVerified']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Usernames ───────────────────────────────────────────────
    match /usernames/{username} {
      // Anyone can check if a username is taken
      allow read: if true;
      // Can claim a username if it maps to their own UID
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Cannot update a username doc (delete and recreate instead)
      allow update: if false;
      // Can release a username if they own it
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid || isAdmin();
    }

    // ── Orders ──────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Customers cannot alter orderStatus or paymentStatus
      allow update: if isAdmin() || (
        isAuthenticated() 
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderStatus', 'paymentStatus', 'subtotal', 'tax', 'total'])
      );
      
      allow delete: if isAdmin();
    }

    // ── Restaurant Configuration ────────────────────────────────
    match /restaurant/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Activity Logs ───────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // ── Analytics ───────────────────────────────────────────────
    match /analytics/{document=**} {
      allow read: if isAdmin();
      // Allow order creation to increment analytics, or strictly restrict to admin
      // For now, restrict to admin (backend function normally handles this)
      allow write: if isAdmin();
    }

    // ── Menu (If migrated to Firestore later) ───────────────────
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ── Reservations (If implemented) ───────────────────────────
    match /reservations/{resId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']));
      allow delete: if isAdmin();
    }
  }
}
