rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ─── users/{uid} ─────────────────────────────────────────────
    // Users can read/write their own profile.
    // They cannot change their own 'role' field.
    // Admins can read all profiles.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && !('role' in request.resource.data
                         && request.resource.data.role != 'customer');
      allow update: if isOwner(uid)
                    // Prevent self-promotion to admin
                    && !('role' in request.resource.data)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── usernames/{username} ────────────────────────────────────
    // Any authenticated user can claim/release their own username doc.
    // The doc only contains { uid: string }.
    match /usernames/{username} {
      allow read:   if true;   // Public — needed to check uniqueness on register
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }

    // ─── orders/{orderId} ────────────────────────────────────────
    // Customers create orders for themselves.
    // Customers read their own orders only.
    // Admins read and update all orders.
    // No one deletes orders (financial record integrity).
    match /orders/{orderId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    // Prevent fabricating payment status
                    && request.resource.data.paymentStatus != 'Refunded';
      allow read:   if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false; // Never delete financial records
    }

    // ─── menuItems/{itemId} ──────────────────────────────────────
    // Anyone can read the menu (public).
    // Only admins can create, update, or delete menu items.
    match /menuItems/{itemId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ─── reservations/{resId} ────────────────────────────────────
    // Authenticated users create reservations for themselves.
    // Admins read and update all reservations.
    match /reservations/{resId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow read:   if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── activityLogs/{logId} ────────────────────────────────────
    // Only admins can read activity logs.
    // Writes come from server-side service calls (adminUser check in code).
    // We allow authenticated writes here; the actor is validated in application code.
    match /activityLogs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ─── restaurant/{document} ───────────────────────────────────
    // Public reads (contact page hours, settings).
    // Admin writes only.
    match /restaurant/{document} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ─── Default deny ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
